{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "snmp_title",
  "description": "snmp_description",

  "configFile": {
    "path": "/etc/wb-mqtt-snmp.conf",
    "service": "wb-mqtt-snmp"
  },

  "definitions": {
    "device": {
      "title": "SNMP protocol version for device",
      "_format": "wb-multiple",
      "oneOf": [
        { "$ref": "#/definitions/deviceDefault" },
        { "$ref": "#/definitions/deviceV2c" },
        { "$ref": "#/definitions/deviceV1" },
        { "$ref": "#/definitions/deviceV3" }
      ],
      "options": {
        "disable_collapse": true,
        "disable_edit_json": true,
        "keep_oneof_values": false,
        "wb": {
          "keep_properties": [
            "enabled", "name", "id", "address", "device_type", "community", "oid_prefix",
            "snmp_timeout", "poll_interval", "channels", "snmp_user",
            "snmp_security_level", "snmp_auth_protocol", "snmp_auth_passphrase",
            "snmp_priv_protocol", "snmp_priv_passphrase", "snmp_context_name"
          ]
        }
      }
    },

    "deviceBase": {
      "type": "object",
      "title": "SNMP device",

      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable device",
          "default": true,
          "_format": "checkbox",
          "propertyOrder": 1
        },
        "name": {
          "type": "string",
          "title": "Device name",
          "description": "Device name to be displayed in UI",
          "minLength": 1,
          "propertyOrder": 10
        },
        "id": {
          "type": "string",
          "title": "MQTT ID of the device",
          "description": "Used as a part of a MQTT topic name",
          "pattern": "^[^$#+\\/]+$",
          "minLength": 1,
          "propertyOrder": 20,
          "options": {
            "patternmessage": "Invalid device name"
          }
        },
        "address": {
          "type": "string",
          "title": "SNMP device address",
          "description": "May be either IP address or domain name",
          "minLength": 1,
          "propertyOrder": 30
        },
        "device_type": {
          "type": "string",
          "title": "Device type",
          "description": "Selects device template",
          "enum": {
            "directories": ["/usr/share/wb-mqtt-snmp/templates"],
            "pointer": "/device_type",
            "pattern": "^.*\\.json"
          },
          "propertyOrder": 40
        },
        "oid_prefix": {
          "type": "string",
          "title": "SNMP object ID prefix (MIB name)",
          "description": "oid_prefix_description",
          "default": "",
          "propertyOrder": 70
        },
        "snmp_timeout": {
          "type": "integer",
          "title": "SNMP timeout (s)",
          "minimum": 0,
          "default": 5,
          "propertyOrder": 90
        },
        "poll_interval": {
          "type": "integer",
          "title": "Desired default poll interval (ms)",
          "description": "poll_interval_description",
          "minimum": 0,
          "default": 1000,
          "propertyOrder": 95
        },
        "channels": {
          "type": "array",
          "title": "List of channels",
          "description": "channels_description",
          "items": { "$ref": "#/definitions/channel" },
          "propertyOrder": 99
        }
      },
      "options": {
          "disable_edit_json": true
      },
      "required": ["address"],
      "defaultProperties": ["address", "device_type", "enabled"]
    },

    "communityDevice": {
      "allOf": [
        { "$ref": "#/definitions/deviceBase" }
      ],
      "properties": {
        "community": {
          "type": "string",
          "title": "SNMP community string",
          "description": "password",
          "propertyOrder": 60
        }
      }
    },

    "snmpV3Fields": {
      "properties": {
        "snmp_user": {
          "title": "SNMPv3 user name",
          "propertyOrder": 81
        },
        "snmp_security_level": {
          "title": "SNMPv3 security level",
          "default": "noAuthNoPriv",
          "propertyOrder": 82
        },
        "snmp_auth_protocol": {
          "title": "SNMPv3 authentication protocol",
          "description": "Required for authNoPriv and authPriv",
          "default": "NoAuth",
          "propertyOrder": 83
        },
        "snmp_auth_passphrase": {
          "format": "password",
          "title": "SNMPv3 authentication passphrase",
          "description": "At least 8 bytes when authentication is enabled",
          "propertyOrder": 84
        },
        "snmp_priv_protocol": {
          "title": "SNMPv3 privacy protocol",
          "default": "NoPriv",
          "propertyOrder": 85
        },
        "snmp_priv_passphrase": {
          "format": "password",
          "title": "SNMPv3 privacy passphrase",
          "description": "At least 8 bytes when privacy is enabled",
          "propertyOrder": 86
        },
        "snmp_context_name": {
          "title": "SNMPv3 context name",
          "default": "",
          "propertyOrder": 87
        }
      }
    },

    "deviceDefault": {
      "title": "From template (default: SNMPv2c)",
      "allOf": [
        { "$ref": "#/definitions/communityDevice" },
        { "$ref": "#/definitions/snmpV3Fields" }
      ],
      "not": { "required": ["snmp_version"] }
    },

    "deviceV2c": {
      "title": "SNMPv2c",
      "allOf": [
        { "$ref": "#/definitions/communityDevice" }
      ],
      "properties": {
        "snmp_version": {
          "type": "string",
          "title": "SNMP protocol version for device",
          "enum": [ "2c" ],
          "default": "2c",
          "options": {
            "hidden": true
          },
          "propertyOrder": 80
        }
      },
      "required": ["snmp_version"],
      "defaultProperties": ["address", "device_type", "enabled", "snmp_version"]
    },

    "deviceV1": {
      "title": "SNMPv1",
      "allOf": [
        { "$ref": "#/definitions/communityDevice" }
      ],
      "properties": {
        "snmp_version": {
          "type": "string",
          "title": "SNMP protocol version for device",
          "enum": [ "1" ],
          "default": "1",
          "options": {
            "hidden": true
          },
          "propertyOrder": 80
        }
      },
      "required": ["snmp_version"],
      "defaultProperties": ["address", "device_type", "enabled", "snmp_version"]
    },

    "snmpV3NoAuthNoPriv": {
      "properties": {
        "snmp_security_level": { "enum": [ "noAuthNoPriv" ] },
        "snmp_auth_protocol": { "enum": [ "NoAuth" ] },
        "snmp_auth_passphrase": { "maxLength": 0 },
        "snmp_priv_protocol": { "enum": [ "NoPriv" ] },
        "snmp_priv_passphrase": { "maxLength": 0 }
      }
    },

    "snmpV3AuthNoPriv": {
      "properties": {
        "snmp_security_level": { "enum": [ "authNoPriv" ] },
        "snmp_auth_protocol": { "not": { "enum": [ "NoAuth" ] } },
        "snmp_auth_passphrase": { "minLength": 1 },
        "snmp_priv_protocol": { "enum": [ "NoPriv" ] },
        "snmp_priv_passphrase": { "maxLength": 0 }
      }
    },

    "snmpV3AuthPriv": {
      "properties": {
        "snmp_security_level": { "enum": [ "authPriv" ] },
        "snmp_auth_protocol": { "not": { "enum": [ "NoAuth" ] } },
        "snmp_auth_passphrase": { "minLength": 1 },
        "snmp_priv_protocol": { "not": { "enum": [ "NoPriv" ] } },
        "snmp_priv_passphrase": { "minLength": 1 }
      }
    },

    "deviceV3": {
      "title": "SNMPv3",
      "allOf": [
        { "$ref": "#/definitions/deviceBase" },
        { "$ref": "#/definitions/snmpV3Fields" }
      ],
      "properties": {
        "snmp_version": {
          "type": "string",
          "title": "SNMP protocol version for device",
          "enum": [ "3" ],
          "default": "3",
          "options": {
            "hidden": true
          },
          "propertyOrder": 80
        },
        "snmp_user": {
          "type": "string",
          "minLength": 1
        },
        "snmp_security_level": {
          "type": "string",
          "enum": [ "noAuthNoPriv", "authNoPriv", "authPriv" ]
        },
        "snmp_auth_protocol": {
          "type": "string",
          "enum": [ "NoAuth", "MD5", "SHA", "SHA224", "SHA256", "SHA384", "SHA512" ]
        },
        "snmp_auth_passphrase": {
          "type": "string"
        },
        "snmp_priv_protocol": {
          "type": "string",
          "enum": [ "NoPriv", "DES", "AES", "AES192", "AES256", "AES192C", "AES256C" ]
        },
        "snmp_priv_passphrase": {
          "type": "string"
        },
        "snmp_context_name": {
          "type": "string"
        }
      },
      "required": ["snmp_version"],
      "dependencies": {
        "snmp_version": {
          "anyOf": [
            {
              "required": ["device_type"],
              "anyOf": [
                { "$ref": "#/definitions/snmpV3NoAuthNoPriv" },
                { "$ref": "#/definitions/snmpV3AuthNoPriv" },
                { "$ref": "#/definitions/snmpV3AuthPriv" }
              ]
            },
            {
              "required": ["snmp_user"],
              "oneOf": [
                { "$ref": "#/definitions/snmpV3NoAuthNoPriv" },
                {
                  "allOf": [
                    { "$ref": "#/definitions/snmpV3AuthNoPriv" }
                  ],
                  "required": ["snmp_security_level", "snmp_auth_protocol", "snmp_auth_passphrase"]
                },
                {
                  "allOf": [
                    { "$ref": "#/definitions/snmpV3AuthPriv" }
                  ],
                  "required": [
                    "snmp_security_level", "snmp_auth_protocol", "snmp_auth_passphrase",
                    "snmp_priv_protocol", "snmp_priv_passphrase"
                  ]
                }
              ]
            }
          ]
        }
      },
      "defaultProperties": [
        "address", "device_type", "enabled", "snmp_version"
      ]
    },

    "channel": {
      "type": "object",
      "title": "Channel",

      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable channel",
          "default": true,
          "_format": "checkbox",
          "propertyOrder": 1
        },
        "name": {
          "type": "string",
          "title": "Control name",
          "description": "This name is displayed both in MQTT topic and UI",
          "pattern": "^[^$#+\\/]+$",
          "minLength": 1,
          "propertyOrder": 10,
          "options": {
            "patternmessage": "Invalid control name"
          }
        },

        "oid": {
          "type": "string",
          "title": "Object ID",
          "description": "OID (starting from dot) or variable name from MIB",
          "propertyOrder": 20
        },

        "control_type": {
          "type": "string",
          "title": "Control type",
          "description": "Defaults to 'text'",
          "enum": [ "text", "value", "temperature", "voltage", "power" ],
          "propertyOrder": 30
        },

        "units": {
          "type": "string",
          "title": "Units",
          "default": "",
          "description": "units_description",
          "propertyOrder": 35,
          "_format": "edWb",
          "options": {
            "enum_values": ["mm/h", "m/s", "W", "kWh", "V", "mV", "m^3/h", "m^3", "Gcal/h", "cal", "Gcal", "Ohm", "mOhm", "bar", "mbar", "s", "min", "h", "m", "g", "kg", "mol", "cd", "%, RH", "deg C", "%", "ppm", "ppb", "A", "mA", "deg", "rad", "lx", "dB", "Hz", "rpm"],
            "enum_titles": ["mm/h", "m/s", "W", "kWh", "V", "mV", "m³/h", "m³", "Gcal/h", "cal", "Gcal", "Ohm", "mOhm", "bar", "mbar (100 Pa)", "s", "min", "h", "m", "g", "kg", "mol", "cd", "%, RH", "°C", "%", "ppm", "ppb", "A", "mA", "°", "rad", "lx", "dB", "Hz", "rpm"]
          }
        },

        "scale": {
          "type": "number",
          "title": "Scale (value multiplier)",
          "default": 1,
          "propertyOrder": 40
        },

        "poll_interval": {
          "type": "integer",
          "title": "Desired poll interval (ms)",
          "description": "poll_interval_description",
          "minimum": 0,
          "default": 1000,
          "propertyOrder": 50
        }
      },
      "options": {
          "disable_edit_json": true
      },
      "required": [ "name" ]
    }
  },

  "properties": {
    "debug": {
      "type": "boolean",
      "title": "Enable debug logging",
      "default": false,
      "_format": "checkbox",
      "propertyOrder": 10
    },
    "num_workers": {
      "type": "integer",
      "title": "Number of SNMP connections",
      "description": "Number of SNMP clients running simultaneously",
      "default": 4,
      "maximum": 64,
      "propertyOrder": 15
    },
    "devices": {
      "type": "array",
      "title": "List of devices",
      "description": "Hosts to be accessed by driver",
      "items": { "$ref": "#/definitions/device" },
      "_format": "list",
      "propertyOrder": 20
    },
    "max_unchanged_interval": {
      "type": "integer",
      "title": "Unchanged value posting interval (s)",
      "description": "max_unchanged_interval_description",
      "default": -1,
      "propertyOrder": 30
    }
  },
  "required": [ "devices" ],
  "options": {
      "disable_edit_json": true
  },
  "translations": {
    "en": {
      "snmp_title": "SNMP Device Driver Configuration",
      "snmp_description": "List devices to poll via SNMP protocol",
      "oid_prefix_description": "Common prefix for names in channel OIDs (for SNMPv2-MIB::sysLocation.0 prefix is SNMPv2-MIB). May be overriden by writing OID in channel with prefix and '::'",
      "poll_interval_description": "Total duration of the poll cycle",
      "channels_description": "List device variables and their corresponding controls",
      "units_description": "Value units of measure (V, A, kWh etc.). Only for control_type == 'value'",
      "max_unchanged_interval_description": "Maximum interval between posting the same value to message queue. Zero - post at every reading, negative - don't post the same values"
    },
    "ru": {
      "snmp_title": "Настройка драйвера SNMP-устройств",
